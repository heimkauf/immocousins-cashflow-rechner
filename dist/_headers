/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/immo-cousins-hero.png
  Cache-Control: public, max-age=31536000, immutable

/immo-cousins-hero.webp
  Cache-Control: public, max-age=31536000, immutable
